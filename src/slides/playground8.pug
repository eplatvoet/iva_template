extends ../templates/base

block vars 
    - var page_title = "Lottie Files Slide"
    - var page_class = "playground-main lottie"
    - var btm_nav = "pg8" 
    - var refs = ""
    - var extra_modals = false
    - var lottieAnimation = true
    //- - var extra_js = false
     

block content
