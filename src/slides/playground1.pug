extends ../templates/base

block vars 
    - var page_title = "Home"
    - var page_class = "home"
    - var btm_nav = "pg1" 
    - var refs = ""
    - var extra_modals = false
    //- - var extra_js = false
     

block content
    div.slide-content-wrapper 
        img(src='./assets/images/background.jpg' class='bg-img')
        div.content-wrap
            h1 IVA Template 
            h2 This template contains basic elements for a Veeva CLM Presentation.
            h3 Directory: 
            div.flex-wrapper 
                div.left-block 
                    p 1 -- Home (current location)
                    p 2 -- Accordion 
                    p 3 -- Carousel 
                    p 4 -- Cards 
                    p 5 -- Video 
                    p 6 -- Progression animation 
                div.right-block 
                    p 7 -- Show/Hide 
                    p 8 -- Lottie files 
                    p 9 -- Tabbed Content 
                    p 10 -- Calculator 
                    p 11 -- Chaptered Video 
                    p 12 -- Resources (Scroll)
                    p 13 -- Resources (Tabbed)
                    p 14 -- PDF Library (w/ PDF Slides)