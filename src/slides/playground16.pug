extends ../templates/base

block vars 
    - var page_title = "Email Slide"
    - var page_class = "playground-main email-frags"
    - var btm_nav = "pg16" 
    - var refs = ""
    - var extra_modals = false
    //- - var extra_js = false
     

block content
    div.slide-content-wrapper 
        div.content-wrap 
            h1 Email Slide
            h2.mt-10 This slide shows an example of sending a Veeva RTE with multiple email fragments.
            div.outer-email-wrapper.mt-40.flex-wrapper.thirds.space-between 
                div.left-block.section-wrap 
                    div.title-wrap 
                        h3.white Product Overview
                    div(class='fragment' id='fragment1' data-efid='12345')
                        div.frag-top 
                            img(src='./assets/images/moa-icon.svg')
                            p.bold.fs-20 Mechanism of Action 
                        div.frag-btm 
                            p.add Tap to add to email
                        div.active-check 
                            img(src='./assets/images/navy-check.svg')
                    div(class='fragment' id='fragment2' data-efid='12346')
                        div.frag-top 
                            img(src='./assets/images/dosing-icon.svg')
                            p.bold.fs-20 Dosing
                        div.frag-btm 
                            p.add Tap to add to email
                        div.active-check 
                            img(src='./assets/images/navy-check.svg')
                    div(class='fragment' id='fragment3' data-efid='12347')
                        div.frag-top 
                            img(src='./assets/images/safety-icon.svg')
                            p.bold.fs-20 Safety
                        div.frag-btm 
                            p.add Tap to add to email
                        div.active-check 
                            img(src='./assets/images/navy-check.svg')
                div.middle-block.section-wrap
                    div.title-wrap 
                        h3.white Clinical Data 
                    div(class='fragment' id='fragment4' data-efid='12348')
                        div.frag-top 
                            img(src='./assets/images/efficacy-icon.svg')
                            p.bold.fs-20.dark-red Efficacy 
                        div.frag-btm 
                            p.add.dark-red Tap to add to email
                        div.active-check 
                            img(src='./assets/images/dark-red-check.svg')
                    div(class='fragment' id='fragment5' data-efid='12349')
                        div.frag-top 
                            img(src='./assets/images/studydesign-icon.svg')
                            p.bold.fs-20.dark-red Study Design
                        div.frag-btm 
                            p.add.dark-red Tap to add to email
                        div.active-check 
                            img(src='./assets/images/dark-red-check.svg')
                    div(class='fragment' id='fragment6' data-efid='12350')
                        div.frag-top 
                            img(src='./assets/images/keyendpoints-icon.svg')
                            p.bold.fs-20.dark-red Key Endpoints
                        div.frag-btm 
                            p.add.dark-red Tap to add to email
                        div.active-check 
                            img(src='./assets/images/dark-red-check.svg')
                div.right-block.section-wrap
                    div.title-wrap 
                        h3.white Patient Support 
                    div(class='fragment' id='fragment7' data-efid='12351')
                        div.frag-top 
                            img(src='./assets/images/savings-icon.svg')
                            p.bold.fs-20.reg-blue Savings Program
                        div.frag-btm 
                            p.add.reg-blue Tap to add to email
                        div.active-check 
                            img(src='./assets/images/reg-blue-check.svg')
                    div(class='fragment' id='fragment8' data-efid='12352')
                        div.frag-top 
                            img(src='./assets/images/resources-icon.svg')
                            p.bold.fs-20.reg-blue Patient Resources
                        div.frag-btm 
                            p.add.reg-blue Tap to add to email
                        div.active-check 
                            img(src='./assets/images/reg-blue-check.svg')
                    div(class='fragment' id='fragment9' data-efid='12353')
                        div.frag-top 
                            img(src='./assets/images/support-icon.svg')
                            p.bold.fs-20.reg-blue Support Services
                        div.frag-btm 
                            p.add.reg-blue Tap to add to email 
                        div.active-check 
                            img(src='./assets/images/reg-blue-check.svg')
            div.btn-wrapper 
                div#sendEtEfBtn.sendEtEfBtn
                    p.white.fs-24.bold Send RTE 
                    img(src='../shared/global-assets/images/email-icon.svg')