extends ../templates/base

block vars 
    - var page_title = "PDF Library Slide"
    - var page_class = "playground-main pdf-library"
    - var btm_nav = "pg14" 
    - var refs = ""
    - var extra_modals = false
    //- - var extra_js = false
     

block content
    div.slide-content-wrapper 
        div.content-wrap 
            h1 PDF Library Slide
            h2.mt-10 This slide contains links that will drive to corresponding PDF slides.
            div.pdf-links-wrapper.mt-40 
                div(class='nav-link pdf-slide-link' data-slide='pdf-library-1')
                    p.bold.fs-24.underline.white PDF 1
                    img(src='./assets/images/caret.svg')
                div(class='nav-link pdf-slide-link' data-slide='pdf-library-2')
                    p.bold.fs-24.underline.white PDF 2
                    img(src='./assets/images/caret.svg')
                div(class='nav-link pdf-slide-link' data-slide='pdf-library-3')
                    p.bold.fs-24.underline.white PDF 3
                    img(src='./assets/images/caret.svg')
                div(class='nav-link pdf-slide-link' data-slide='pdf-library-4')
                    p.bold.fs-24.underline.white PDF 4
                    img(src='./assets/images/caret.svg')
                div(class='nav-link pdf-slide-link' data-slide='pdf-library-5')
                    p.bold.fs-24.underline.white PDF 5
                    img(src='./assets/images/caret.svg')
                div(class='nav-link pdf-slide-link' data-slide='pdf-library-6')
                    p.bold.fs-24.underline.white PDF 6
                    img(src='./assets/images/caret.svg')